{
  "manifest_version": 3,
  "name": "TrueDub",
  "version": "0.1.0",
  "description": "Real English dubbing for YouTube videos that auto-dub skips. Runs locally.",
  "minimum_chrome_version": "140",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["http://127.0.0.1:7861/*", "https://*.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["settings.js", "content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
